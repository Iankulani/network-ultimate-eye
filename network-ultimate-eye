            for tv in (self.dash_alerts, self.t_tree, self.r_tree, self.a_tree, self.s_tree, self.i_tree):
                tv.delete(*tv.get_children())
            nports = 0
            for t in d["targets"]:
                sc = d["scans"].get(t["ip"])
                n = len(sc["open"]) if sc else 0
                nports += n
                state = "up" if self.e.was_up.get(t["ip"]) and not self.e.fail_streak.get(t["ip"]) else \
                    ("DOWN" if self.e.fail_streak.get(t["ip"]) else "-")
                self.t_tree.insert("", "end", iid=t["ip"], values=(
                    t["ip"], t["label"], "yes" if t.get("critical") else "", sc["time"] if sc else "never", n, state))
                for p in (sc["open"] if sc else []):
                    self.r_tree.insert("", "end", values=(t["ip"], p["port"], p["service"], p["risk"],
                                                          p["latency"], p["banner"]))
            for a in reversed(d["alerts"][-300:]):
                self.a_tree.insert("", "end", iid="a%d" % a["id"], tags=(a["severity"],), values=(
                    a["id"], a["time"], a["severity"], a["kind"], a["target"], a["message"], a["incident"] or ""))
            for a in reversed(d["alerts"][-8:]):
                self.dash_alerts.insert("", "end", tags=(a["severity"],), values=(
