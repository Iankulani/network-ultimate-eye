class WebApp:
    def __init__(self, engine):
        self.e, self.srv, self.th = engine, None, None

    def start(self):
        s = self.e.store.settings
        self.srv = ThreadingHTTPServer((s["web_host"], int(s["web_port"])), make_handler(self.e))
        self.th = threading.Thread(target=self.srv.serve_forever, daemon=True)
        self.th.start()
        self.e.log("Web app: http://%s:%s/?token=%s" % (s["web_host"], s["web_port"], s["web_token"]))

    def stop(self):
        if self.srv:
            self.srv.shutdown()
            self.srv.server_close()
            self.srv = None
            self.e.log("Web app stopped")

    @property
    def running(self):
        return self.srv is not None


