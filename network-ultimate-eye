# -------------------------------------------------- chat bridges (inbound) ---
class Bridges:
    """Telegram and Signal long-poll command bridges."""

    def __init__(self, engine):
        self.e = engine
        self.stop = threading.Event()
        self.threads = []

    def start(self):
        s = self.e.store.settings
        self.stop.clear()
        if s["telegram_enabled"] and s["telegram_token"]:
            self.threads.append(threading.Thread(target=self._telegram, daemon=True))
        if s["signal_enabled"] and s["signal_number"]:
            self.threads.append(threading.Thread(target=self._signal, daemon=True))
        for t in self.threads:
            t.start()
        if self.threads:
            self.e.log("Chat bridges started (%d)" % len(self.threads))

    def shutdown(self):
        self.stop.set()
        self.threads = []

    def _telegram(self):
        off = 0
        while not self.stop.is_set():
            s = self.e.store.settings
            try:
                url = "https://api.telegram.org/bot%s/getUpdates?timeout=20&offset=%d" % (s["telegram_token"], off)
                data = json.loads(urllib.request.urlopen(url, timeout=30).read().decode())
                for u in data.get("result", []):
                    off = u["update_id"] + 1
                    m = u.get("message") or {}
                    if str(m.get("chat", {}).get("id")) != str(s["telegram_chat_id"]):
                        continue
                    self.e.notifier.telegram(self.e.command(m.get("text", "")))
            except Exception as ex:
                self.e.log("Telegram bridge: %s" % ex)
                self.stop.wait(10)

    def _signal(self):
        while not self.stop.is_set():
            s = self.e.store.settings
            allowed = {r.strip() for r in s["signal_recipients"].split(",") if r.strip()}
            try:
                url = "%s/v1/receive/%s" % (s["signal_url"].rstrip("/"), urllib.parse.quote(s["signal_number"]))
                msgs = json.loads(urllib.request.urlopen(url, timeout=30).read().decode() or "[]")
                for m in msgs:
                    env = m.get("envelope", {})
                    text = (env.get("dataMessage") or {}).get("message")
                    if text and env.get("source") in allowed:
                        self.e.notifier.signal(self.e.command(text))
            except Exception as ex:
                self.e.log("Signal bridge: %s" % ex)
            self.stop.wait(5)


# ------------------------------------------------------------ web application
def make_handler(engine):
    class H(BaseHTTPRequestHandler):
        server_version = "nuE"

        def log_message(self, *a):
            pass

        def _auth(self, q):
            tok = engine.store.settings["web_token"]
            given = (q.get("token", [""])[0] or self.headers.get("X-Nue-Token", "") or
                     re.sub(r"^Bearer\s+", "", self.headers.get("Authorization", "")))
            ck = self.headers.get("Cookie", "")
            m = re.search(r"nue_token=([\w\-]+)", ck)
            given = given or (m.group(1) if m else "")
            return hmac.compare_digest(given, tok)

        def _send(self, code, body, ctype="text/html; charset=utf-8", extra=None):
            b = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(b)))
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(b)

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(u.query)
            if not self._auth(q):
                return self._send(401, "<h3>nuE: token required (?token=...)</h3>")
            ck = {"Set-Cookie": "nue_token=%s; HttpOnly; SameSite=Strict" % engine.store.settings["web_token"]}
            if u.path == "/api/status":
                return self._send(200, json.dumps({"targets": engine.ips(), "alerts": engine.store.data["alerts"][-50:],
                                                   "monitoring": engine.monitoring}), "application/json")
            if u.path == "/report":
                return self._send(200, engine.report_html(), extra=ck)
            self._send(200, self.dashboard(), extra=ck)

        def do_POST(self):
            u = urllib.parse.urlparse(self.path)
            q = urllib.parse.parse_qs(u.query)
            n = int(self.headers.get("Content-Length", 0) or 0)
            raw = self.rfile.read(min(n, 1 << 20))
            if not self._auth(q):
                return self._send(401, "{}", "application/json")
            try:
                if u.path == "/slack":
                    sec = engine.store.settings.get("slack_signing_secret")
                    if sec:
                        ts = self.headers.get("X-Slack-Request-Timestamp", "0")
                        base = ("v0:%s:%s" % (ts, raw.decode())).encode()
                        sig = "v0=" + hmac.new(sec.encode(), base, hashlib.sha256).hexdigest()
                        if abs(time.time() - float(ts)) > 300 or not hmac.compare_digest(
                                sig, self.headers.get("X-Slack-Signature", "")):
                            return self._send(401, "{}", "application/json")
                    form = urllib.parse.parse_qs(raw.decode())
                    text = form.get("text", ["help"])[0]
                    return self._send(200, json.dumps({"response_type": "ephemeral",
                                                       "text": engine.command(text)}), "application/json")
                if u.path == "/gchat":
                    j = json.loads(raw or b"{}")
                    msg = j.get("message", {})
                    text = msg.get("argumentText") or msg.get("text") or "help"
                    return self._send(200, json.dumps({"text": engine.command(text)}), "application/json")
                if u.path == "/api/cmd":
                    j = json.loads(raw or b"{}")
                    return self._send(200, json.dumps({"reply": engine.command(j.get("text", ""))}),
                                      "application/json")
            except Exception as e:
                return self._send(500, json.dumps({"error": str(e)}), "application/json")
            self._send(404, "{}", "application/json")

        def dashboard(self):
            d = engine.store.data
            esc = html.escape
            bar, pie = port_stats(engine.store)
            tr = "".join("<tr><td>%s</td><td>%s</td><td>%s</td><td>%d</td></tr>" %
                         (esc(t["ip"]), esc(t["label"]), "yes" if t.get("critical") else "",
                          len(d["scans"].get(t["ip"], {}).get("open", []))) for t in d["targets"])
            al = "".join("<tr><td>%s</td><td style='color:%s'>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" %
                         (a["time"], SEV_COLOR[a["severity"]], a["severity"], esc(a["kind"]), esc(a["target"]),
