        def run_scan(self, ips):
            if self.scan_busy:
                messagebox.showinfo(APP, "A scan is already running.")
                return
            self.scan_busy = True
            self.scan_stop.clear()

            def job():
                try:
                    for n, ip in enumerate(ips, 1):
                        if self.scan_stop.is_set():
                            break
                        self.after(0, lambda ip=ip, n=n: self.status.set("Scanning %s (%d/%d)" % (ip, n, len(ips))))
                        self.e.scan(ip, progress=lambda d, t: self.after(
                            0, lambda: self.pb.configure(value=100.0 * d / max(1, t))), stop=self.scan_stop)
                except Exception as ex:
                    self.e.log("Scan error: %s" % ex)
                finally:
                    self.scan_busy = False
                    self.after(0, lambda: (self.pb.configure(value=0), self.status.set("Scan finished")))
            threading.Thread(target=job, daemon=True).start()

