def run_cli(argv):
    ap = argparse.ArgumentParser(prog="nue", description="nuE network threat monitor (no args = GUI)")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("gui", help="open the graphical interface")
    p = sub.add_parser("add", help="add targets (IP, range, CIDR)")
    p.add_argument("targets", nargs="+")
    p.add_argument("--label", default="")
    p.add_argument("--critical", action="store_true")
    p = sub.add_parser("remove")
    p.add_argument("ip")
    sub.add_parser("list", help="list targets")
    p = sub.add_parser("scan", help="scan targets (all if none given)")
    p.add_argument("ips", nargs="*")
    p.add_argument("--ports", help="override port spec")
    p = sub.add_parser("monitor", help="start threat monitoring")
    p.add_argument("--duration", type=int, default=0, help="seconds (0 = until Ctrl+C)")
    p.add_argument("--web", action="store_true", help="also start web app")
    p.add_argument("--bridges", action="store_true", help="also start Telegram/Signal command bridges")
    sub.add_parser("path", help="shortest attack paths")
    p = sub.add_parser("chart", help="export bar/pie chart of open ports")
    p.add_argument("--type", choices=("bar", "pie"), required=True)
    p.add_argument("--out", required=True, help=".svg or .png")
    p.add_argument("--ip")
    p = sub.add_parser("web", help="run the web application")
    p.add_argument("--port", type=int)
    sub.add_parser("alerts")
    p = sub.add_parser("analyst", help="manage SOC analysts")
    p.add_argument("action", choices=("add", "list", "remove"))
    p.add_argument("--name")
    p.add_argument("--role", default="Tier1", choices=ROLES)
    p.add_argument("--oncall", action="store_true")
    p.add_argument("--id", type=int)
    sub.add_parser("incidents")
    p = sub.add_parser("report")
    p.add_argument("out")
    p = sub.add_parser("cmd", help="run a chat-style command, e.g. cmd status")
    p.add_argument("text", nargs="+")
    a = ap.parse_args(argv)

    e = Engine()
    if a.cmd in (None, "gui"):
        return run_gui(e)
    if a.cmd == "add":
        print("added:", ", ".join(e.add_targets(" ".join(a.targets), a.label, a.critical)) or "nothing new")
    elif a.cmd == "remove":
        e.remove_target(a.ip)
    elif a.cmd == "list":
        for t in e.store.data["targets"]:
            sc = e.store.data["scans"].get(t["ip"], {})
            print("%-40s %-15s %s open=%d" % (t["ip"], t["label"], "CRITICAL" if t.get("critical") else "",
                                              len(sc.get("open", []))))
    elif a.cmd == "scan":
        if a.ports:
            e.store.settings["ports"] = a.ports
        ips = a.ips or e.ips()
        for ip in ips:
            if ip not in e.ips():
                e.add_targets(ip)
            for r in e.scan(ip):
                print("%-40s %5d/tcp %-14s risk=%d  %s" % (ip, r["port"], r["service"], r["risk"], r["banner"]))
    elif a.cmd == "monitor":
        if a.web:
            e.web = WebApp(e)
            e.web.start()
        if a.bridges:
            Bridges(e).start()
        e.start_monitoring()
        t0 = time.time()
        try:
            while not a.duration or time.time() - t0 < a.duration:
                try:
                    while True:
                        print(e.logq.get(timeout=1))
                except queue.Empty:
                    pass
        except KeyboardInterrupt:
            pass
        e.stop_monitoring()
        while not e.logq.empty():
            print(e.logq.get())
    elif a.cmd == "path":
        print(format_paths(attack_paths(e.store)[0]))
    elif a.cmd == "chart":
        bar, pie = port_stats(e.store, a.ip)
        write_chart(a.type, bar if a.type == "bar" else pie,
                    "Open ports" if a.type == "bar" else "Service share", a.out)
        print("written", a.out)
    elif a.cmd == "web":
        if a.port:
            e.store.settings["web_port"] = a.port
        w = WebApp(e)
        w.start()
        print(e.logq.get())
        try:
            while True:
                time.sleep(1)
        except KeyboardInterrupt:
            w.stop()
    elif a.cmd == "alerts":
        for x in e.store.data["alerts"][-50:]:
            print("#%d %s [%s] %s %s: %s" % (x["id"], x["time"], x["severity"], x["kind"], x["target"], x["message"]))
    elif a.cmd == "analyst":
        if a.action == "add":
            print(e.soc.add_analyst(a.name or "analyst", a.role, on_call=a.oncall))
        elif a.action == "remove":
            e.store.data["analysts"] = [x for x in e.store.data["analysts"] if x["id"] != a.id]
            e.store.save()
        else:
            print(e.command("analysts"))
    elif a.cmd == "incidents":
        print(e.command("incidents"))
    elif a.cmd == "report":
        with open(a.out, "w", encoding="utf-8") as f:
            f.write(e.report_html())
        print("written", a.out)
    elif a.cmd == "cmd":
        print(e.command(" ".join(a.text)))


if __name__ == "__main__":
    run_cli(sys.argv[1:])
