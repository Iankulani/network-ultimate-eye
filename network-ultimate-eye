        def draw_bar(self, cv, data, title):
            cv.delete("all")
            W, H = cv.winfo_width() or 600, cv.winfo_height() or 400
            cv.create_text(W / 2, 18, text=title, fill=FG, font=("Segoe UI", 12, "bold"))
            if not data:
                cv.create_text(W / 2, H / 2, text="No data - run a scan first", fill=MUTED)
                return
            mx = max(v for _, v in data)
            L, R, T, B = 50, 20, 40, 70
            pw, ph = W - L - R, H - T - B
            bw = pw / len(data)
            for g in range(5):
                y = T + ph - ph * g / 4
                cv.create_line(L, y, W - R, y, fill=BORDER)
                cv.create_text(L - 8, y, text="%.0f" % (mx * g / 4), fill=MUTED, anchor="e")
            for i, (lab, v) in enumerate(data):
                x0, x1 = L + i * bw + bw * 0.15, L + (i + 1) * bw - bw * 0.15
                y1 = T + ph
                y0 = y1 - ph * v / mx
                cv.create_rectangle(x0, y0, x1, y1, fill=PALETTE[i % len(PALETTE)], outline="")
                cv.create_text((x0 + x1) / 2, y0 - 9, text=str(v), fill=FG)
                cv.create_text((x0 + x1) / 2, y1 + 14, text=lab, fill=FG, angle=40 if len(data) > 6 else 0,
                               anchor="w" if len(data) > 6 else "n", font=("Segoe UI", 8))

        def draw_pie(self, cv, data, title):
            cv.delete("all")
            W, H = cv.winfo_width() or 600, cv.winfo_height() or 400
            cv.create_text(W / 2, 18, text=title, fill=FG, font=("Segoe UI", 12, "bold"))
            total = sum(v for _, v in data)
            if not total:
                cv.create_text(W / 2, H / 2, text="No data - run a scan first", fill=MUTED)
                return
            r = min(W * 0.32, H * 0.38)
            cx, cy = W * 0.32, H / 2 + 12
            start = 90.0
            for i, (lab, v) in enumerate(data):
                ext = -360.0 * v / total
                col = PALETTE[i % len(PALETTE)]
                if len(data) == 1:
                    cv.create_oval(cx - r, cy - r, cx + r, cy + r, fill=col, outline=BG)
                else:
                    cv.create_arc(cx - r, cy - r, cx + r, cy + r, start=start, extent=ext, fill=col, outline=BG,
                                  style="pieslice")
                start += ext
                cv.create_rectangle(W * 0.64, 60 + i * 24, W * 0.64 + 12, 72 + i * 24, fill=col, outline="")
                cv.create_text(W * 0.64 + 20, 66 + i * 24, anchor="w", fill=FG,
                               text="%s - %d (%.0f%%)" % (lab, v, 100.0 * v / total))

