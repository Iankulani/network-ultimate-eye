        # ---- change points
        def draw_cp(self):
            cv = self.cv_cp
            cv.delete("all")
            W, H = cv.winfo_width() or 600, cv.winfo_height() or 400
            key = self.cp_sel.get()
            ser = [(t, v) for t, v in self.e.series.get(key, []) if v is not None]
            cv.create_text(W / 2, 16, text="Series: %s" % (key or "-"), fill=FG, font=("Segoe UI", 12, "bold"))
            if len(ser) < 2:
                cv.create_text(W / 2, H / 2, text="Start monitoring to collect data", fill=MUTED)
                return
            L, R, T, B = 60, 20, 36, 30
            ts, vs = [s[0] for s in ser], [s[1] for s in ser]
            t0, t1 = ts[0], ts[-1]
            lo, hi = min(vs), max(vs)
            if hi == lo:
                hi, lo = hi + 1, lo - 1

            def X(t):
                return L + (W - L - R) * (t - t0) / max(1e-9, t1 - t0)

            def Y(v):
                return H - B - (H - T - B) * (v - lo) / (hi - lo)
            for g in range(5):
                y = H - B - (H - T - B) * g / 4
                cv.create_line(L, y, W - R, y, fill=BORDER)
                cv.create_text(L - 6, y, text="%.1f" % (lo + (hi - lo) * g / 4), fill=MUTED, anchor="e")
            pts = []
            for t, v in ser:
                pts += [X(t), Y(v)]
            cv.create_line(*pts, fill=ACCENT2, width=2)
            for t, d in self.e.cp_marks.get(key, []):
                if t0 <= t <= t1:
                    cv.create_line(X(t), T, X(t), H - B, fill="#fb923c", dash=(4, 3), width=2)
            # offline CUSUM over the displayed window as well
            s = self.e.store.settings
            for i, d in change_points(vs, float(s["cusum_k"]), float(s["cusum_h"])):
                cv.create_oval(X(ts[i]) - 4, Y(vs[i]) - 4, X(ts[i]) + 4, Y(vs[i]) + 4, fill=BADC, outline="")

