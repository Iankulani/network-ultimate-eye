                          for i in d["incidents"][-20:])
            paths, _ = attack_paths(engine.store)
            return ("<html><head><meta charset='utf-8'><meta http-equiv='refresh' content='10'><title>nuE</title><style>"
                    "body{background:%s;color:%s;font-family:Segoe UI,Arial;margin:0}header{background:%s;padding:14px 24px;"
                    "font-size:22px;font-weight:bold;border-bottom:2px solid %s}main{padding:20px;display:grid;"
                    "grid-template-columns:1fr 1fr;gap:18px}section{background:%s;border:1px solid %s;border-radius:8px;"
                    "padding:12px;overflow:auto}h3{margin:0 0 8px;color:%s}table{width:100%%;border-collapse:collapse}"
                    "td,th{border-bottom:1px solid %s;padding:4px 6px;font-size:13px;text-align:left}a{color:%s}"
