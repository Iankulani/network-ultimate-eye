# ------------------------------------------------------------- utilities ----
def parse_ports(spec):
    ports = set()
    for tok in re.split(r"[,\s;]+", str(spec).strip()):
        if not tok:
            continue
        if "-" in tok:
            a, b = tok.split("-", 1)
            a, b = int(a), int(b)
            if not (1 <= a <= b <= 65535):
                raise ValueError("bad port range: " + tok)
            ports.update(range(a, b + 1))
        else:
            p = int(tok)
            if not 1 <= p <= 65535:
                raise ValueError("bad port: " + tok)
            ports.add(p)
    return sorted(ports)


def parse_targets(text):
    """Accepts: 10.0.0.5  10.0.0.1-20  10.0.0.1-10.0.0.9  192.168.1.0/24  (comma/space/newline separated)."""
    out = []
    for tok in re.split(r"[,\s;]+", text.strip()):
        if not tok:
            continue
        if "/" in tok:
            net = ipaddress.ip_network(tok, strict=False)
            hosts = list(net.hosts()) if net.num_addresses > 2 else list(net)
            if len(hosts) > 1024:
                raise ValueError("CIDR too large (max 1024 hosts): " + tok)
            out += [str(h) for h in hosts]
        elif "-" in tok:
            a, b = tok.split("-", 1)
            s = ipaddress.ip_address(a)
            if "." in b or ":" in b:
                e = ipaddress.ip_address(b)
            else:
                e = ipaddress.ip_address(a.rsplit(".", 1)[0] + "." + b)
            if type(s) is not type(e) or int(e) < int(s) or int(e) - int(s) > 1023:
                raise ValueError("bad range: " + tok)
            out += [str(type(s)(n)) for n in range(int(s), int(e) + 1)]
        else:
            out.append(str(ipaddress.ip_address(tok)))
    seen, res = set(), []
    for ip in out:
        if ip not in seen:
            seen.add(ip)
            res.append(ip)
    return res


def service_name(port):
    if port in COMMON_PORTS:
        return COMMON_PORTS[port]
    try:
        return socket.getservbyport(port, "tcp")
    except OSError:
        return "unknown"


def risk_of(service):
    return RISK.get(service, 2)


def http_post(url, payload, headers=None, timeout=10, form=False):
    if form:
        body = urllib.parse.urlencode(payload).encode()
        ctype = "application/x-www-form-urlencoded"
    else:
        body = json.dumps(payload).encode()
        ctype = "application/json"
    h = {"Content-Type": ctype, "User-Agent": "nuE/" + VERSION}
    h.update(headers or {})
    req = urllib.request.Request(url, data=body, headers=h, method="POST")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode("utf-8", "replace")


# ------------------------------------------------------------------ store ---
class Store:
    def __init__(self, path=DB_PATH):
        self.path = path
        self.lock = threading.RLock()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        self.data = self._load()

    def _load(self):
        data = json.loads(json.dumps(DEFAULTS))
        if os.path.exists(self.path):
            try:
                with open(self.path, "r", encoding="utf-8") as f:
                    saved = json.load(f)
                for k, v in saved.items():
                    if k == "settings":
                        data["settings"].update(v)
                    else:
                        data[k] = v
            except (OSError, ValueError):
                pass
        if not data["settings"].get("web_token"):
            data["settings"]["web_token"] = secrets.token_urlsafe(18)
        return data

    def save(self):
        with self.lock:
            tmp = self.path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.data, f, indent=1)
            os.replace(tmp, self.path)

    def next_id(self, kind):
        with self.lock:
            self.data["counters"][kind] = self.data["counters"].get(kind, 0) + 1
            return self.data["counters"][kind]

    @property
    def settings(self):
        return self.data["settings"]


# ------------------------------------------------------------ port scanner --
def probe_port(ip, port, timeout, grab=True):
    fam = socket.AF_INET6 if ":" in ip else socket.AF_INET
    s = socket.socket(fam, socket.SOCK_STREAM)
    s.settimeout(timeout)
    t0 = time.perf_counter()
    try:
        if s.connect_ex((ip, port)) != 0:
            return None
        lat = (time.perf_counter() - t0) * 1000.0
        banner = ""
        if grab:
            try:
                if port in HTTP_PORTS and port != 443 and port != 8443:
                    s.sendall(b"HEAD / HTTP/1.0\r\n\r\n")
                s.settimeout(0.4)
                raw = s.recv(160).decode("latin-1", "replace").strip()
                banner = raw.splitlines()[0][:90] if raw else ""
            except OSError:
                pass
        return {"port": port, "latency": round(lat, 2), "banner": banner}
    except OSError:
        return None
    finally:
        s.close()


def scan_host(ip, ports, timeout=0.8, threads=200, progress=None, stop=None):
    results, done = [], [0]
    lock = threading.Lock()

    def work(p):
        if stop is not None and stop.is_set():
            return
        r = probe_port(ip, p, timeout)
        with lock:
            done[0] += 1
            if r:
                svc = service_name(p)
                r["service"] = svc
                r["risk"] = risk_of(svc)
                results.append(r)
            if progress and done[0] % 64 == 0:
                progress(done[0], len(ports))

    with ThreadPoolExecutor(max_workers=max(1, min(threads, len(ports)))) as ex:
        list(ex.map(work, ports))
    if progress:
        progress(len(ports), len(ports))
    return sorted(results, key=lambda r: r["port"])


# ---------------------------------------------------- connection tracking ---
TCP_STATES = {"01": "ESTABLISHED", "02": "SYN_SENT", "03": "SYN_RECV", "04": "FIN_WAIT1",
              "05": "FIN_WAIT2", "06": "TIME_WAIT", "07": "CLOSE", "08": "CLOSE_WAIT",
              "09": "LAST_ACK", "0A": "LISTEN", "0B": "CLOSING"}


def _hex_ip(h):
    if len(h) == 8:
        return socket.inet_ntoa(bytes.fromhex(h)[::-1])
    chunks = [bytes.fromhex(h[i:i + 8])[::-1] for i in range(0, 32, 8)]
    return socket.inet_ntop(socket.AF_INET6, b"".join(chunks))


def local_connections():
    """Returns list of (state, local_ip, local_port, remote_ip, remote_port). Real data from the OS."""
    conns = []
    try:
        import psutil  # optional
        for c in psutil.net_connections(kind="tcp"):
            if c.raddr:
                conns.append((c.status, c.laddr.ip, c.laddr.port, c.raddr.ip, c.raddr.port))
            elif c.status:
                conns.append((c.status, c.laddr.ip, c.laddr.port, "", 0))
        return conns
    except Exception:
        pass
    if os.path.exists("/proc/net/tcp"):
        for fn in ("/proc/net/tcp", "/proc/net/tcp6"):
            try:
                with open(fn) as f:
                    next(f)
                    for line in f:
                        p = line.split()
                        lip, lport = p[1].split(":")
                        rip, rport = p[2].split(":")
                        conns.append((TCP_STATES.get(p[3], p[3]), _hex_ip(lip), int(lport, 16),
                                      _hex_ip(rip), int(rport, 16)))
            except (OSError, ValueError, StopIteration):
                continue
        return conns
    try:
        out = subprocess.run(["netstat", "-an"], capture_output=True, text=True, timeout=15).stdout
    except Exception:
        return conns
    states = set(TCP_STATES.values()) | {"SYN_RCVD", "ESTAB"}
    for line in out.splitlines():
        t = line.split()
        st = next((x for x in t if x.upper() in states), None)
        if not st or len(t) < 4:
            continue
        i = t.index(st)
        loc, rem = t[i - 2], t[i - 1]

        def sp(a):
            a = a.replace("[", "").replace("]", "")
            if ":" in a and a.count(":") == 1 or a.count(".") == 4:
                a, _, p = a.rpartition(":" if ":" in a else ".")
            else:
                a, _, p = a.rpartition(":")
            return a, int(p) if p.isdigit() else 0
        li, lp = sp(loc)
        ri, rp = sp(rem)
        conns.append(("SYN_RECV" if st.upper() == "SYN_RCVD" else st.upper(), li, lp, ri, rp))
    return conns


# ---------------------------------------------------- change point (CUSUM) --
class CUSUM:
    """Two-sided tabular CUSUM on standardised values with a warm-up baseline."""

    def __init__(self, k=0.5, h=6.0, warm=12):
        self.k, self.h, self.warm = k, h, warm
        self.reset()

    def reset(self):
        self.n, self.mean, self.m2, self.sp, self.sn = 0, 0.0, 0.0, 0.0, 0.0

    def _welford(self, x):
        self.n += 1
        d = x - self.mean
        self.mean += d / self.n
        self.m2 += d * (x - self.mean)

    def update(self, x):
        """returns +1 (upward shift), -1 (downward shift) or 0"""
        if self.n < self.warm:
            self._welford(x)
            return 0
        sd = max(math.sqrt(self.m2 / max(1, self.n - 1)), 0.05 * abs(self.mean), 1e-6)
        z = (x - self.mean) / sd
        self.sp = max(0.0, self.sp + z - self.k)
        self.sn = max(0.0, self.sn - z - self.k)
        if self.sp > self.h:
            self.reset()
            self._welford(x)
            return 1
        if self.sn > self.h:
            self.reset()
            self._welford(x)
            return -1
        if self.sp == 0 and self.sn == 0 and self.n < 500:
            self._welford(x)
        return 0


def change_points(values, k=0.5, h=6.0, warm=12):
    c = CUSUM(k, h, warm)
    return [(i, d) for i, v in enumerate(values) for d in [c.update(v)] if d]


# -------------------------------------------------------- attack path graph -
def build_attack_graph(store):
    """Nodes: 'Internet' + scanned hosts. Edge cost = 11 - exploitability (lower = easier)."""
    edges = {"Internet": []}
    hosts = {}
    for ip, sc in store.data["scans"].items():
        if any(t["ip"] == ip for t in store.data["targets"]):
            hosts[ip] = sc.get("open", [])
    for ip in hosts:
        edges.setdefault(ip, [])
    for ip, ports in hosts.items():
        if ports:
            best = max(ports, key=lambda p: p.get("risk", 2))
            edges["Internet"].append((ip, max(1, 11 - best["risk"]),
                                      "exploit %s/%d" % (best["service"], best["port"])))

    def same_net(a, b):
        A, B = ipaddress.ip_address(a), ipaddress.ip_address(b)
        if A.version != B.version:
            return False
        return ipaddress.ip_network("%s/%d" % (a, 24 if A.version == 4 else 64), strict=False) \
            == ipaddress.ip_network("%s/%d" % (b, 24 if B.version == 4 else 64), strict=False)

    for a in hosts:
        for b, ports in hosts.items():
            if a == b or not same_net(a, b):
                continue
            lat = [p for p in ports if p["service"] in LATERAL_SERVICES]
            if lat:
                best = max(lat, key=lambda p: p.get("risk", 2))
                edges[a].append((b, max(1, 11 - best["risk"]) + 1,
                                 "pivot via %s/%d" % (best["service"], best["port"])))
    return edges


def shortest_path(edges, src, dst):
    dist, prev = {src: 0}, {}
    pq = [(0, src)]
    while pq:
        d, u = heapq.heappop(pq)
        if u == dst:
            break
        if d > dist.get(u, 1e18):
            continue
        for v, w, why in edges.get(u, []):
            nd = d + w
            if nd < dist.get(v, 1e18):
                dist[v] = nd
                prev[v] = (u, why)
                heapq.heappush(pq, (nd, v))
    if dst not in dist:
        return None, None
    path, cur = [], dst
    while cur != src:
        u, why = prev[cur]
        path.append((u, cur, why))
        cur = u
    return list(reversed(path)), dist[dst]


def attack_paths(store):
    edges = build_attack_graph(store)
    crit = [t["ip"] for t in store.data["targets"] if t.get("critical")]
    goals = crit or [t["ip"] for t in store.data["targets"]]
    res = []
    for g in goals:
        if g in edges:
            path, cost = shortest_path(edges, "Internet", g)
            if path:
                res.append({"target": g, "critical": g in crit, "cost": cost, "path": path})
    res.sort(key=lambda r: (not r["critical"], r["cost"]))
    return res, edges


def format_paths(paths):
    if not paths:
        return "No attack path found (scan targets first, or no exposed services lead to the goal)."
    lines = []
    for r in paths:
        lines.append("%s target %s  (ease cost %d - lower is easier)" %
                     ("CRITICAL" if r["critical"] else "Host", r["target"], r["cost"]))
        for i, (a, b, why) in enumerate(r["path"], 1):
            lines.append("   %d. %s -> %s   [%s]" % (i, a, b, why))
        lines.append("")
    return "\n".join(lines)


# ------------------------------------------------------------------ charts --
def port_stats(store, ip=None):
    ports, svcs = Counter(), Counter()
    for h, sc in store.data["scans"].items():
        if ip and h != ip:
            continue
        for p in sc.get("open", []):
            ports["%d/%s" % (p["port"], p["service"])] += 1
            svcs[p["service"]] += 1
    bar = ports.most_common(12)
    pie = svcs.most_common(8)
    rest = sum(svcs.values()) - sum(v for _, v in pie)
    if rest > 0:
        pie.append(("other", rest))
    return bar, pie


def bar_svg(title, data, w=760, h=440):
    o = ['<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">' % (w, h, w, h),
         '<rect width="100%%" height="100%%" fill="%s"/>' % BG,
         '<text x="%d" y="28" fill="%s" font-family="Arial" font-size="18" text-anchor="middle">%s</text>'
         % (w // 2, FG, html.escape(title))]
    if data:
        mx = max(v for _, v in data)
        L, R, T, B = 55, 20, 50, 80
        pw, ph = w - L - R, h - T - B
        bw = pw / len(data)
        for g in range(0, 5):
            y = T + ph - ph * g / 4
            o.append('<line x1="%d" y1="%.1f" x2="%d" y2="%.1f" stroke="%s"/>' % (L, y, w - R, y, BORDER))
            o.append('<text x="%d" y="%.1f" fill="%s" font-size="11" text-anchor="end" font-family="Arial">%.0f</text>'
                     % (L - 6, y + 4, MUTED, mx * g / 4))
        for i, (lab, v) in enumerate(data):
            x0 = L + i * bw + bw * 0.15
            bwid = bw * 0.7
            bh = ph * v / mx
            o.append('<rect x="%.1f" y="%.1f" width="%.1f" height="%.1f" fill="%s"/>'
                     % (x0, T + ph - bh, bwid, bh, PALETTE[i % len(PALETTE)]))
            o.append('<text x="%.1f" y="%.1f" fill="%s" font-size="12" text-anchor="middle" font-family="Arial">%d</text>'
                     % (x0 + bwid / 2, T + ph - bh - 6, FG, v))
            o.append('<text x="%.1f" y="%.1f" fill="%s" font-size="11" text-anchor="end" font-family="Arial" '
                     'transform="rotate(-40 %.1f %.1f)">%s</text>'
                     % (x0 + bwid / 2 + 6, T + ph + 16, FG, x0 + bwid / 2 + 6, T + ph + 16, html.escape(lab)))
    else:
        o.append('<text x="%d" y="%d" fill="%s" text-anchor="middle" font-family="Arial">No data</text>'
                 % (w // 2, h // 2, MUTED))
    o.append("</svg>")
    return "\n".join(o)


def pie_svg(title, data, w=760, h=440):
    o = ['<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">' % (w, h, w, h),
         '<rect width="100%%" height="100%%" fill="%s"/>' % BG,
         '<text x="%d" y="28" fill="%s" font-family="Arial" font-size="18" text-anchor="middle">%s</text>'
         % (w // 2, FG, html.escape(title))]
    total = sum(v for _, v in data)
    if total:
        cx, cy, r = 250, 240, 150
        ang = -math.pi / 2
        for i, (lab, v) in enumerate(data):
            col = PALETTE[i % len(PALETTE)]
            if len(data) == 1:
                o.append('<circle cx="%d" cy="%d" r="%d" fill="%s"/>' % (cx, cy, r, col))
            else:
                a2 = ang + 2 * math.pi * v / total
                x1, y1 = cx + r * math.cos(ang), cy + r * math.sin(ang)
                x2, y2 = cx + r * math.cos(a2), cy + r * math.sin(a2)
                o.append('<path d="M%d,%d L%.1f,%.1f A%d,%d 0 %d 1 %.1f,%.1f Z" fill="%s" stroke="%s"/>'
                         % (cx, cy, x1, y1, r, r, 1 if a2 - ang > math.pi else 0, x2, y2, col, BG))
                ang = a2
            o.append('<rect x="480" y="%d" width="14" height="14" fill="%s"/>' % (80 + i * 26, col))
            o.append('<text x="502" y="%d" fill="%s" font-size="13" font-family="Arial">%s - %d (%.0f%%)</text>'
                     % (92 + i * 26, FG, html.escape(lab), v, 100.0 * v / total))
    else:
        o.append('<text x="%d" y="%d" fill="%s" text-anchor="middle" font-family="Arial">No data</text>'
                 % (w // 2, h // 2, MUTED))
    o.append("</svg>")
    return "\n".join(o)


def chart_png(kind, data, title, path):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=(8, 4.8), dpi=130)
    fig.patch.set_facecolor(BG)
    ax.set_facecolor(PANEL)
    ax.set_title(title, color=FG)
    if data:
        labels, vals = [d[0] for d in data], [d[1] for d in data]
        if kind == "bar":
            ax.bar(labels, vals, color=PALETTE[:len(vals)] * 2)
            ax.tick_params(colors=FG)
            plt.setp(ax.get_xticklabels(), rotation=40, ha="right")
        else:
            ax.pie(vals, labels=labels, colors=PALETTE, textprops={"color": FG}, autopct="%1.0f%%")
    fig.tight_layout()
    fig.savefig(path, facecolor=BG)
    plt.close(fig)


def write_chart(kind, data, title, path, canvas=None):
    ext = os.path.splitext(path)[1].lower()
    if ext == ".svg":
        svg = (bar_svg if kind == "bar" else pie_svg)(title, data)
        with open(path, "w", encoding="utf-8") as f:
            f.write(svg)
    elif ext == ".png":
        chart_png(kind, data, title, path)
    elif ext in (".ps", ".eps") and canvas is not None:
        canvas.postscript(file=path, colormode="color")
    else:
        raise ValueError("unsupported format '%s' (use .svg, .png or .ps)" % ext)


# --------------------------------------------------------------- notifier ---
class Notifier:
    def __init__(self, store):
        self.store = store

    def _s(self):
        return self.store.settings

    def discord(self, text):
        http_post(self._s()["discord_webhook"], {"content": text[:1900]})

    def slack(self, text):
        http_post(self._s()["slack_webhook"], {"text": text})

    def gchat(self, text):
        http_post(self._s()["gchat_webhook"], {"text": text})

    def telegram(self, text):
        s = self._s()
        http_post("https://api.telegram.org/bot%s/sendMessage" % s["telegram_token"],
                  {"chat_id": s["telegram_chat_id"], "text": text[:4000]})

    def signal(self, text):
        s = self._s()
        rec = [r.strip() for r in s["signal_recipients"].split(",") if r.strip()]
        http_post(s["signal_url"].rstrip("/") + "/v2/send",
                  {"message": text, "number": s["signal_number"], "recipients": rec})

    CHANNELS = ("discord", "slack", "gchat", "telegram", "signal")

    def send(self, text, only=None):
        errors = []
        for ch in self.CHANNELS:
            if only and ch != only:
                continue
            if self._s().get(ch + "_enabled"):
                try:
                    getattr(self, ch)(text)
                except Exception as e:
                    errors.append("%s: %s" % (ch, e))
        return errors


# -------------------------------------------------------------------- SOC ---
ROLES = ("Tier1", "Tier2", "Tier3", "Lead", "Manager")
STATUSES = ("open", "investigating", "contained", "closed")


class SOC:
    def __init__(self, store, touch):
        self.store, self.touch = store, touch

    def add_analyst(self, name, role="Tier1", email="", shift="day", on_call=False):
        with self.store.lock:
            a = {"id": self.store.next_id("analyst"), "name": name, "role": role, "email": email,
                 "shift": shift, "on_call": bool(on_call), "active": True}
            self.store.data["analysts"].append(a)
            self.store.save()
        self.touch()
        return a

    def analyst(self, aid):
        return next((a for a in self.store.data["analysts"] if a["id"] == aid), None)

    def load(self, aid):
        return sum(1 for i in self.store.data["incidents"]
                   if i["assignee"] == aid and i["status"] != "closed")

    def pick(self, sev):
        pool = [a for a in self.store.data["analysts"] if a["active"]]
        oncall = [a for a in pool if a["on_call"]]
        pool = oncall or pool
        if SEV.get(sev, 1) >= 3:
            senior = [a for a in pool if a["role"] in ("Tier2", "Tier3", "Lead", "Manager")]
            pool = senior or pool
        return min(pool, key=self.load)["id"] if pool else None

    def create_incident(self, title, sev="medium", alert_id=None, assignee=None):
        with self.store.lock:
            inc = {"id": self.store.next_id("incident"), "title": title, "severity": sev,
                   "status": "open", "assignee": assignee or self.pick(sev), "created": now_str(),
                   "alert_id": alert_id, "notes": []}
            self.store.data["incidents"].append(inc)
            if alert_id:
                for a in self.store.data["alerts"]:
                    if a["id"] == alert_id:
                        a["incident"] = inc["id"]
            self.store.save()
        self.touch()
        return inc

    def incident(self, iid):
        return next((i for i in self.store.data["incidents"] if i["id"] == iid), None)

    def update(self, iid, **kw):
        with self.store.lock:
            i = self.incident(iid)
            if i:
                i.update(kw)
                self.store.save()
        self.touch()

    def add_note(self, iid, note, author="system"):
        with self.store.lock:
            i = self.incident(iid)
            if i:
                i["notes"].append({"time": now_str(), "author": author, "text": note})
                self.store.save()
        self.touch()

    def name(self, aid):
        a = self.analyst(aid)
        return a["name"] if a else "unassigned"


# ----------------------------------------------------------------- engine ---
class Engine:
    def __init__(self, store=None):
        self.store = store or Store()
        self.notifier = Notifier(self.store)
        self.version = 0
        self.logq = queue.Queue()
        self.soc = SOC(self.store, self.touch)
        self.series = {}          # key -> deque[(ts, value)]
        self.cusums = {}
        self.cp_marks = {}        # key -> list of (ts, direction)
        self.cooldown = {}
        self.fail_streak = {}
        self.was_up = {}
        self.stop_evt = threading.Event()
        self.mon_thread = None
        self.cycle = 0
        self.web = None
        self.bridges = None

    # --- plumbing
    def touch(self):
        self.version += 1

    def log(self, msg):
        line = "[%s] %s" % (datetime.datetime.now().strftime("%H:%M:%S"), msg)
        self.logq.put(line)

    @property
    def monitoring(self):
        return bool(self.mon_thread and self.mon_thread.is_alive())

    # --- targets
    def add_targets(self, text, label="", critical=False):
        added = []
        with self.store.lock:
            have = {t["ip"] for t in self.store.data["targets"]}
            for ip in parse_targets(text):
                if ip not in have:
                    self.store.data["targets"].append(
                        {"ip": ip, "label": label, "critical": critical, "added": now_str()})
                    added.append(ip)
            self.store.save()
        self.touch()
        self.log("Added %d target(s)" % len(added))
        return added

    def remove_target(self, ip):
        with self.store.lock:
            d = self.store.data
            d["targets"] = [t for t in d["targets"] if t["ip"] != ip]
            d["scans"].pop(ip, None)
            d["baseline"].pop(ip, None)
            self.store.save()
        self.touch()

    def set_critical(self, ip, value):
        with self.store.lock:
            for t in self.store.data["targets"]:
                if t["ip"] == ip:
                    t["critical"] = bool(value)
            self.store.save()
        self.touch()

    def ips(self):
        return [t["ip"] for t in self.store.data["targets"]]

    # --- scanning
    def scan(self, ip, progress=None, stop=None, diff=True):
        s = self.store.settings
        ports = parse_ports(s["ports"])
        self.log("Scanning %s (%d ports)..." % (ip, len(ports)))
        res = scan_host(ip, ports, float(s["timeout"]), int(s["threads"]), progress, stop)
        with self.store.lock:
            self.store.data["scans"][ip] = {"time": now_str(), "open": res}
            base = self.store.data["baseline"].get(ip)
            if base is None:
                self.store.data["baseline"][ip] = [r["port"] for r in res]
            self.store.save()
        self.touch()
        self.log("Scan of %s done: %d open port(s)" % (ip, len(res)))
        if diff and base is not None:
            for r in res:
                if r["port"] not in base:
                    self.raise_alert("high" if r["risk"] >= 8 else "medium", "new-open-port", ip,
                                     "New open port %d/%s (risk %d) not in baseline" %
                                     (r["port"], r["service"], r["risk"]))
        return res

    def scan_all(self, progress=None, stop=None):
        for ip in self.ips():
            if stop is not None and stop.is_set():
                break
            self.scan(ip, progress, stop)

    def reset_baseline(self, ip=None):
        with self.store.lock:
            for h, sc in self.store.data["scans"].items():
                if ip is None or h == ip:
                    self.store.data["baseline"][h] = [p["port"] for p in sc["open"]]
            self.store.save()
        self.touch()

    # --- alerts
    def raise_alert(self, sev, kind, target, msg):
        s = self.store.settings
        key = (kind, target)
        t = time.time()
        if t - self.cooldown.get(key, 0) < float(s["alert_cooldown"]):
            return None
        self.cooldown[key] = t
        with self.store.lock:
            a = {"id": self.store.next_id("alert"), "time": now_str(), "severity": sev,
                 "kind": kind, "target": target, "message": msg, "incident": None, "ack": False}
            self.store.data["alerts"].append(a)
            self.store.data["alerts"] = self.store.data["alerts"][-2000:]
            self.store.save()
        self.log("ALERT [%s] %s %s: %s" % (sev.upper(), kind, target, msg))
        if s.get("auto_incident") and SEV[sev] >= 3:
            self.soc.create_incident("%s on %s" % (kind, target), sev, a["id"])
        if SEV[sev] >= SEV.get(s["min_notify_severity"], 2):
            threading.Thread(target=self._notify, daemon=True,
                             args=("nuE ALERT [%s] %s | %s | %s" % (sev.upper(), kind, target, msg),)).start()
        self.touch()
        return a

    def _notify(self, text):
        for e in self.notifier.send(text):
            self.log("Notify error: " + e)

    # --- monitoring
    def start_monitoring(self):
        if self.monitoring:
            return
        self.stop_evt.clear()
        self.mon_thread = threading.Thread(target=self._loop, daemon=True)
        self.mon_thread.start()
        self.log("Monitoring started")
        self.touch()

    def stop_monitoring(self):
        self.stop_evt.set()
        self.log("Monitoring stopped")
        self.touch()

    def _record(self, key, value):
        dq = self.series.setdefault(key, deque(maxlen=720))
        dq.append((time.time(), value))
        return dq

    def _cusum(self, key):
        s = self.store.settings
        if key not in self.cusums:
            self.cusums[key] = CUSUM(float(s["cusum_k"]), float(s["cusum_h"]))
        return self.cusums[key]

    def _loop(self):
        while not self.stop_evt.is_set():
            t0 = time.time()
            ips = self.ips()
            try:
                self._check_local_flood()
                if ips:
                    with ThreadPoolExecutor(max_workers=min(32, len(ips))) as ex:
                        list(ex.map(self._check_target, ips))
                self.cycle += 1
                if self.cycle % max(1, int(self.store.settings["rescan_every"])) == 0:
                    for ip in ips:
                        if self.stop_evt.is_set():
                            break
                        self.scan(ip)
            except Exception as e:  # keep monitor alive
                self.log("Monitor error: %s" % e)
            self.touch()
            self.stop_evt.wait(max(1.0, float(self.store.settings["monitor_interval"]) - (time.time() - t0)))

    def _probe_ports_for(self, ip):
        sc = self.store.data["scans"].get(ip)
        if sc and sc["open"]:
            return [p["port"] for p in sc["open"]][:4]
        return parse_ports(self.store.settings["probe_ports"])

    def _check_target(self, ip):
        timeout = max(1.0, float(self.store.settings["timeout"]) * 2)
        lat = None
        for p in self._probe_ports_for(ip):
            r = probe_port(ip, p, timeout, grab=False)
            if r:
                lat = r["latency"]
                break
        self._record(ip, lat)
        if lat is None:
            self.fail_streak[ip] = self.fail_streak.get(ip, 0) + 1
            if self.was_up.get(ip) and self.fail_streak[ip] >= 3:
                self.raise_alert("high", "availability-loss", ip,
                                 "Target stopped answering for %d probes (possible DoS)" % self.fail_streak[ip])
            return
        self.fail_streak[ip] = 0
        self.was_up[ip] = True
        d = self._cusum(ip).update(lat)
        if d:
            self.cp_marks.setdefault(ip, []).append((time.time(), d))
            if d > 0:
                self.raise_alert("high" if lat > 500 else "medium", "latency-change-point", ip,
                                 "Upward latency shift detected (now %.1f ms) - possible DoS/saturation" % lat)
            else:
                self.log("Latency dropped on %s (change point, now %.1f ms)" % (ip, lat))

    def _check_local_flood(self):
        s = self.store.settings
        conns = local_connections()
        if not conns:
            return
        per_ip = Counter()
        syn = 0
        for st, lip, lport, rip, rport in conns:
            if st == "SYN_RECV":
                syn += 1
            if rip and st not in ("LISTEN", "") and rip not in ("127.0.0.1", "::1", "0.0.0.0", "::"):
                per_ip[rip] += 1
        total = sum(per_ip.values())
        self._record("local:connections", total)
        self._record("local:syn_recv", syn)
        for ip, n in per_ip.most_common(3):
            if n >= int(s["dos_conn_per_ip"]):
                self.raise_alert("high", "connection-flood", ip,
                                 "%d simultaneous connections from one source (threshold %s)" %
                                 (n, s["dos_conn_per_ip"]))
        if syn >= int(s["dos_syn_recv"]):
            self.raise_alert("critical", "syn-flood", "localhost",
                             "%d half-open (SYN_RECV) connections - SYN flood indicator" % syn)
        d = self._cusum("local:connections").update(total)
        if d > 0:
            self.cp_marks.setdefault("local:connections", []).append((time.time(), d))
            self.raise_alert("medium", "connection-change-point", "localhost",
                             "Sudden rise in inbound connection count (now %d)" % total)

    # --- commands (shared by chat bots and the web app)
    def command(self, text):
        t = text.strip().lstrip("/")
        t = re.sub(r"^nue[\s:]+", "", t, flags=re.I)
        parts = t.split(None, 1)
        if not parts:
            return self.command("help")
        cmd = parts[0].split("@")[0].lower()
        arg = parts[1].strip() if len(parts) > 1 else ""
        d = self.store.data
        try:
            if cmd in ("help", "start"):
                return ("nuE commands: status | targets | add <ips> | remove <ip> | scan <ip|all> | ports <ip> | "
                        "alerts [n] | path | monitor start|stop | analysts | incidents | ack <incident id> close")
            if cmd == "status":
                return "nuE: %d targets, %d alerts, %d open incidents, monitoring=%s" % (
                    len(d["targets"]), len(d["alerts"]),
                    sum(1 for i in d["incidents"] if i["status"] != "closed"), self.monitoring)
            if cmd == "targets":
                return "\n".join("%s %s%s" % (t["ip"], t["label"], " [critical]" if t.get("critical") else "")
                                 for t in d["targets"]) or "no targets"
            if cmd == "add":
                return "added: " + (", ".join(self.add_targets(arg)) or "nothing new")
            if cmd == "remove":
                self.remove_target(arg)
                return "removed " + arg
            if cmd == "scan":
                ips = self.ips() if arg in ("", "all") else [arg]
                threading.Thread(target=lambda: [self.scan(i) for i in ips], daemon=True).start()
                return "scan started for %d target(s); results come as alerts, use 'ports <ip>'" % len(ips)
            if cmd == "ports":
                sc = d["scans"].get(arg)
                if not sc:
                    return "no scan data for " + arg
                return "\n".join("%d/%s risk %d" % (p["port"], p["service"], p["risk"]) for p in sc["open"]) \
                    or "no open ports"
            if cmd == "alerts":
                n = int(arg) if arg.isdigit() else 5
                return "\n".join("#%d [%s] %s %s: %s" % (a["id"], a["severity"], a["kind"], a["target"], a["message"])
                                 for a in d["alerts"][-n:]) or "no alerts"
            if cmd == "path":
                return format_paths(attack_paths(self.store)[0])
            if cmd == "monitor":
                if arg == "start":
                    self.start_monitoring()
                    return "monitoring started"
                self.stop_monitoring()
                return "monitoring stopped"
            if cmd == "analysts":
                return "\n".join("#%d %s (%s)%s" % (a["id"], a["name"], a["role"], " on-call" if a["on_call"] else "")
                                 for a in d["analysts"]) or "no analysts"
            if cmd == "incidents":
                return "\n".join("#%d [%s] %s - %s -> %s" % (i["id"], i["severity"], i["title"], i["status"],
                                                           self.soc.name(i["assignee"]))
                                 for i in d["incidents"][-10:]) or "no incidents"
            if cmd == "ack":
                m = re.match(r"(\d+)\s+(\w+)", arg)
                if m and m.group(2) in STATUSES:
                    self.soc.update(int(m.group(1)), status=m.group(2))
                    return "incident %s -> %s" % (m.group(1), m.group(2))
                return "usage: ack <id> open|investigating|contained|closed"
        except Exception as e:
            return "error: %s" % e
        return "unknown command, try 'help'"

    # --- report
    def report_html(self):
