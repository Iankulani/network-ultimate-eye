        def draw_path_graph(self):
            cv = self.cv_path
            cv.delete("all")
            paths, edges = self.last_paths
            W, H = cv.winfo_width() or 600, cv.winfo_height() or 300
            nodes = list(edges.keys())
            if len(nodes) < 2:
                cv.create_text(W / 2, H / 2, text="Scan targets, then compute paths", fill=MUTED)
                return
            pos = {"Internet": (60, H / 2)}
            others = [n for n in nodes if n != "Internet"]
            for i, n in enumerate(others):
                ang = -math.pi / 2 + 2 * math.pi * i / len(others)
                pos[n] = (W / 2 + (W / 2 - 110) * math.cos(ang) * 0.9, H / 2 + (H / 2 - 40) * math.sin(ang))
            hot = {(a, b) for r in paths for a, b, _ in r["path"]}
            for a, lst in edges.items():
                for b, w, why in lst:
                    (x1, y1), (x2, y2) = pos[a], pos[b]
                    col = "#fb923c" if (a, b) in hot else BORDER
                    cv.create_line(x1, y1, x2, y2, fill=col, width=3 if (a, b) in hot else 1, arrow="last")
            crit = {t["ip"] for t in self.e.store.data["targets"] if t.get("critical")}
            for n, (x, y) in pos.items():
                col = BADC if n in crit else (WARNC if n == "Internet" else ACCENT)
                cv.create_oval(x - 14, y - 14, x + 14, y + 14, fill=col, outline=FG)
                cv.create_text(x, y + 26, text=n, fill=FG, font=("Segoe UI", 8))

