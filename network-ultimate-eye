    class FormDialog(tk.Toplevel):
        def __init__(self, parent, title, fields, on_ok):
            super().__init__(parent)
            self.title(title)
            self.configure(bg=BG)
            self.transient(parent)
            self.vars, self.on_ok = {}, on_ok
            for r, f in enumerate(fields):
                key, label, kind, val = f[:4]
                opts = f[4] if len(f) > 4 else ()
                ttk.Label(self, text=label).grid(row=r, column=0, sticky="w", padx=10, pady=4)
                if kind == "bool":
                    v = tk.BooleanVar(value=bool(val))
                    ttk.Checkbutton(self, variable=v).grid(row=r, column=1, sticky="w", padx=10)
                elif kind == "choice":
                    v = tk.StringVar(value=str(val))
                    ttk.Combobox(self, textvariable=v, values=list(opts), state="readonly",
                                 width=38).grid(row=r, column=1, padx=10)
                else:
                    v = tk.StringVar(value=str(val))
                    ttk.Entry(self, textvariable=v, width=42, show="*" if kind == "secret" else "").grid(
                        row=r, column=1, padx=10)
                self.vars[key] = (v, kind)
            bf = ttk.Frame(self)
            bf.grid(row=len(fields), column=0, columnspan=2, pady=10)
            ttk.Button(bf, text="OK", command=self.ok).pack(side="left", padx=6)
            ttk.Button(bf, text="Cancel", command=self.destroy).pack(side="left", padx=6)
            self.grab_set()

        def ok(self):
            out = {}
            try:
                for k, (v, kind) in self.vars.items():
                    x = v.get()
                    out[k] = int(x) if kind == "int" else float(x) if kind == "float" else x
            except ValueError as e:
                messagebox.showerror(APP, "Invalid value: %s" % e, parent=self)
                return
            try:
                self.on_ok(out)
            except Exception as e:
                messagebox.showerror(APP, str(e), parent=self)
                return
            self.destroy()

